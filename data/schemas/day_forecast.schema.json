{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sailwise.dev/schemas/day_forecast.schema.json",
  "title": "SailWise normalised day forecast",
  "description": "A day of hourly weather in SailWise canonical units, as produced by any WeatherProvider adapter. Fixtures under data/fixtures/ use this shape with provenance SYNTHETIC.",
  "type": "object",
  "required": ["id", "spot_id", "date", "hours", "provenance"],
  "properties": {
    "id": { "type": "string" },
    "spot_id": { "type": "string" },
    "spot_name": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "timezone": { "type": "string", "description": "IANA timezone, e.g. Europe/Rome" },
    "provenance": {
      "enum": ["MEASURED", "FORECAST", "MODELLED", "ESTIMATED", "CACHED", "USER", "SYNTHETIC"]
    },
    "provider_id": { "type": ["string", "null"] },
    "model_id": { "type": ["string", "null"] },
    "issued_at": { "type": ["string", "null"], "format": "date-time" },
    "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
    "attribution": { "type": ["string", "null"] },
    "warning": { "type": "string", "description": "required on synthetic fixtures" },
    "units": { "type": "object" },
    "hours": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hour" } },
    "accessibility": { "$ref": "#/$defs/accessibility" }
  },
  "$defs": {
    "hour": {
      "type": "object",
      "required": ["hour", "wind_kn", "gust_kn"],
      "properties": {
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "wind_kn": { "type": "number", "minimum": 0 },
        "gust_kn": { "type": "number", "minimum": 0 },
        "wind_dir_deg": { "type": "number", "minimum": 0, "maximum": 360, "description": "meteorological: the direction the wind comes FROM" },
        "temp_c": { "type": "number" },
        "precip_mm": { "type": "number", "minimum": 0 },
        "precip_prob": { "type": "number", "minimum": 0, "maximum": 1 },
        "cloud_frac": { "type": "number", "minimum": 0, "maximum": 1 },
        "pressure_hpa": { "type": ["number", "null"] },
        "visibility_m": { "type": "number", "minimum": 0 },
        "storm_prob": { "type": "number", "minimum": 0, "maximum": 1 },
        "wave_height_m": { "type": ["number", "null"], "description": "null = provider does not supply it; never defaulted" },
        "wave_period_s": { "type": ["number", "null"] }
      }
    },
    "accessibility": {
      "type": "object",
      "description": "Sub-factors in [0, 1]. null means UNKNOWN and is excluded from the weighted average, not treated as zero (FR-P-03).",
      "properties": {
        "launch": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "parking": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "drive": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "services": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "note": { "type": "string" }
      }
    }
  }
}
